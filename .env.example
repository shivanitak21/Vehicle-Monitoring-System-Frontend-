# Copy to .env and fill in real values. Never commit .env.
# Only EXPO_PUBLIC_ variables are visible inside the app bundle.

# REST API origin, no trailing slash.
EXPO_PUBLIC_API_URL=https://api.example.com/v1

# Socket.IO origin used for live GPS, trip status, and safety events.
EXPO_PUBLIC_SOCKET_URL=https://api.example.com

# EAS project UUID from `eas init`. Required to fetch an Expo push token.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Used at native build time by the react-native-maps config plugin.
# Leave blank to use Apple Maps on iOS and Expo Go's default Android map.
GOOGLE_MAPS_API_KEY=
